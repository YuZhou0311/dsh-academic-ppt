{
  "name": "dsh-academic-ppt",
  "version": "0.7.0-rc.8",
  "description": "DeepSeek Harness学术汇报插件：36种原生信息卡、模板参考、生图参考规划、逐页学术设计与可编辑PPTX。",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./core": "./src/core.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-academic-ppt": "bin/academic-ppt.mjs"
  },
  "files": [
    "src",
    "bin",
    "skills",
    "examples",
    "docs",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=2 test/*.test.mjs",
    "demo": "node scripts/build-demo.mjs",
    "check": "node scripts/check-package.mjs",
    "references": "node scripts/build-references.mjs",
    "cards": "node scripts/build-card-library.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "pptxgenjs": "4.0.1"
  },
  "license": "MIT",
  "author": "YuZhou",
  "private": true,
  "overrides": {
    "@deepseek-ai/libreoffice-kit": {
      "fflate": "0.8.3"
    },
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  },
  "optionalDependencies": {
    "@deepseek-ai/libreoffice-kit": "0.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuZhou0311/dsh-academic-ppt.git"
  },
  "homepage": "https://github.com/YuZhou0311/dsh-academic-ppt#readme"
}
